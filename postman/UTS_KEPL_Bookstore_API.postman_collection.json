			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Dapatkan Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (pm.response.code === 200 && jsonData.access_token) {",
									"    pm.collectionVariables.set('auth_token', jsonData.access_token);",
									"    console.log('Token berhasil disimpan ke variabel koleksi: ' + jsonData.access_token);",
									"}",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response contains access_token', function () {",
									"    pm.expect(jsonData).to.have.property('access_token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
